GRAPHQL_API_URL=https://graphql-gateway.holidayguru.dev
GRAPHQL_BRAND_ID=
GRAPHQL_LOCALE=de

# Optional. Use local for deterministic tool routing without an LLM.
# Supported values: local, openai, anthropic
AI_PROVIDER=local

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
